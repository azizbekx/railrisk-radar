# Copy to .streamlit/secrets.toml (gitignored), or paste into Streamlit Community Cloud > App settings > Secrets.
# app.py copies these into the environment when the same variable is not already set.

# Jury login: comma-separated user:password pairs. Leave out to run without a login.
APP_USERS = "jury:change-me"

NEBIUS_API_KEY = ""
TAVILY_API_KEY = ""

# Optional
# LLM_PROVIDER = "nebius"
# NEMOTRON_MODEL = "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
