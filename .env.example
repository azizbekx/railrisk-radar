NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: force a model, otherwise the best Nemotron on Token Factory is picked
# NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# nebius = Nemotron on Token Factory (production, saves credits); claude = Anthropic (local dev)
# Local: LLM_PROVIDER=claude + ANTHROPIC_API_KEY. Deployed: LLM_PROVIDER=nebius + NEBIUS_API_KEY.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Jury login for the deployed app (comma-separated user:password). Unset = no login.
# APP_USERS=jury:change-me
