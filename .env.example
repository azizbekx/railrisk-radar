NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: force a model, otherwise the best Nemotron on Token Factory is picked
# NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Temporary stand-in while Nebius is set up: LLM_PROVIDER=claude + ANTHROPIC_API_KEY
LLM_PROVIDER=nebius
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Jury login for the deployed app (comma-separated user:password). Unset = no login.
# APP_USERS=jury:change-me

# Results stay in each browser session. Set to 1 on the presenter's machine to also save the last research,
# memo, scenario etc. to cache/last_*.json so they survive a restart. Leave unset on a shared deployment.
# PERSIST_DEMO_CACHE=1
